{
  "_comment": "Memory-efficient config for GPU training - optimized for RTX 2080 (8-11GB VRAM)",
  "model_name": "Qwen/Qwen2.5-0.5B-Instruct",
  "dataset_path": "datasets/all_mental_health_combined",
  "output_dir": "models/qwen2.5-0.5b-counsel-chat-memory-efficient",
  "batch_size": 2,
  "num_epochs": 2,
  "learning_rate": 5e-4,
  "use_wandb": false,
  "use_4bit": true,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "max_length": 512,
  "gradient_accumulation_steps": 8,
  "eval_batch_size": 4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "logging_steps": 10,
  "eval_steps": 100,
  "save_steps": 500,
  "save_total_limit": 2,
  "fp16": false,
  "bf16": true,
  "early_stopping": true,
  "seed": 42,
  "run_name": "qwen2.5-0.5b-counsel-chat-memory-efficient",
  "wandb_project": "qwen2.5-counsel-chat",
  "dataloader_num_workers": 8,
  "dataloader_pin_memory": true,
  "gradient_checkpointing": true,
  "ddp_find_unused_parameters": false,
  "optim": "adamw_torch_fused",
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "lr_scheduler_type": "cosine",
  "remove_unused_columns": true,
  "low_cpu_mem_usage": true,
  "use_cache": false
}

{
  "_comment": "Qwen2.5-1.5B-Instruct - Optimized for MAXIMUM TRAINING SPEED on 8 GPUs (RTX 2080 Ti)",
  "_performance": "~2-3x faster than 3B, can use much higher batch sizes for rapid convergence",
  "_effective_batch": "Effective batch size = 8 GPUs × 8 batch × 4 accumulation = 256 samples per update",

  "model_name": "Qwen/Qwen2.5-1.5B-Instruct",
  "dataset_path": "datasets/all_mental_health_combined",
  "output_dir": "models/qwen2.5-1.5b-fast-8gpu",

  "batch_size": 8,
  "num_epochs": 3,
  "learning_rate": 3e-4,
  "use_wandb": false,

  "use_4bit": true,
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],

  "max_length": 1024,
  "gradient_accumulation_steps": 4,
  "eval_batch_size": 16,
  "eval_accumulation_steps": 2,

  "weight_decay": 0.01,
  "warmup_ratio": 0.05,
  "logging_steps": 5,
  "eval_steps": 50,
  "save_steps": 200,
  "save_total_limit": 3,

  "fp16": false,
  "bf16": true,
  "prediction_loss_only": true,
  "early_stopping": true,
  "seed": 42,

  "run_name": "qwen2.5-1.5b-fast-8gpu",
  "wandb_project": "qwen2.5-1.5b-counsel-chat",

  "dataloader_num_workers": 4,
  "dataloader_pin_memory": true,
  "gradient_checkpointing": true,
  "ddp_find_unused_parameters": false,

  "optim": "adamw_torch_fused",
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "lr_scheduler_type": "cosine",

  "save_strategy": "steps",
  "eval_strategy": "steps",
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",
  "greater_is_better": false,
  "report_to": "none",
  "remove_unused_columns": false,
  "use_cache": false,

  "_optimization_notes": [
    "Higher batch_size (8) leverages smaller model size for speed",
    "Lower gradient_accumulation (4) for faster updates",
    "Higher LoRA rank (32) for better quality without slowdown on 1.5B",
    "Increased learning_rate (3e-4) for faster convergence",
    "Reduced warmup (0.05) to start learning faster",
    "More frequent eval (50 steps) to catch best model early",
    "More workers (4) for faster data loading",
    "Prediction_loss_only for faster evaluation"
  ]
}

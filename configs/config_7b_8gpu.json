{
  "_comment": "7B model config optimized for 8 RTX 2080 Ti GPUs (11GB VRAM each) with FSDP",
  "model_name": "Qwen/Qwen2.5-7B-Instruct",
  "dataset_path": "datasets/all_mental_health_combined",
  "output_dir": "models/qwen2.5-7b-counsel-chat-8gpu",
  "batch_size": 1,
  "num_epochs": 2,
  "learning_rate": 1.5e-4,
  "use_wandb": false,
  "use_4bit": true,
  "lora_r": 4,
  "lora_alpha": 8,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj"
  ],
  "max_length": 516,
  "gradient_accumulation_steps": 16,
  "eval_batch_size": 1,
  "eval_accumulation_steps": 4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "logging_steps": 10,
  "eval_steps": 100,
  "save_steps": 500,
  "save_total_limit": 3,
  "fp16": true,
  "bf16": false,
  "prediction_loss_only": true,
  "early_stopping": true,
  "seed": 42,
  "run_name": "qwen2.5-7b-counsel-chat-8gpu",
  "wandb_project": "qwen2.5-7b-counsel-chat",
  "dataloader_num_workers": 0,
  "dataloader_pin_memory": false,
  "gradient_checkpointing": true,
  "ddp_find_unused_parameters": false,
  "optim": "adamw_torch_fused",
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "lr_scheduler_type": "cosine",
  "remove_unused_columns": false,
  "use_cache": false
}

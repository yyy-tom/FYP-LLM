{
  "_comment": "CPU-only training config for 80 CPU cores (if GPU not available)",
  "model_name": "Qwen/Qwen2.5-0.5B-Instruct",
  "dataset_path": "datasets/all_mental_health_combined",
  "output_dir": "models/qwen2.5-0.5b-counsel-chat-cpu",
  "batch_size": 2,
  "num_epochs": 3,
  "learning_rate": 5e-4,
  "use_wandb": false,
  "use_4bit": false,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "max_length": 512,
  "gradient_accumulation_steps": 16,
  "eval_batch_size": 4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "logging_steps": 10,
  "eval_steps": 100,
  "save_steps": 500,
  "save_total_limit": 3,
  "fp16": false,
  "bf16": false,
  "early_stopping": true,
  "seed": 42,
  "run_name": "qwen2.5-0.5b-counsel-chat-cpu-80cores",
  "wandb_project": "qwen2.5-counsel-chat",
  "dataloader_num_workers": 32,
  "dataloader_pin_memory": false,
  "gradient_checkpointing": true,
  "ddp_find_unused_parameters": false,
  "optim": "adamw_torch",
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "lr_scheduler_type": "cosine",
  "remove_unused_columns": true,
  "low_cpu_mem_usage": true,
  "use_cache": false,
  "save_strategy": "steps",
  "eval_strategy": "steps",
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",
  "greater_is_better": false,
  "report_to": "none"
}

{
  "_comment": "Qwen2.5-1.5B-Instruct - BLAZING FAST mode - Maximum speed, minimal quality",
  "_use_case": "Fastest possible training - 30-45 minutes on 8 GPUs",
  "_effective_batch": "Effective batch size = 8 GPUs × 8 batch × 2 accumulation = 128 samples per update",
  "_quality_warning": "This config prioritizes SPEED over quality. Expect reduced performance.",

  "model_name": "Qwen/Qwen2.5-1.5B-Instruct",
  "dataset_path": "datasets/all_mental_health_combined",
  "output_dir": "models/qwen2.5-1.5b-blazing-fast",

  "batch_size": 8,
  "num_epochs": 1,
  "learning_rate": 5e-4,
  "use_wandb": false,
  "ignore_checkpoints": true,

  "use_4bit": true,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "lora_target_modules": ["q_proj", "v_proj"],

  "max_length": 512,
  "gradient_accumulation_steps": 2,
  "eval_batch_size": 16,
  "eval_accumulation_steps": 1,

  "weight_decay": 0.0,
  "warmup_ratio": 0.01,
  "logging_steps": 20,
  "eval_steps": 200,
  "save_steps": 500,
  "save_total_limit": 1,

  "fp16": false,
  "bf16": true,
  "prediction_loss_only": true,
  "early_stopping": false,
  "seed": 42,

  "run_name": "qwen2.5-1.5b-blazing-fast",
  "wandb_project": "qwen2.5-1.5b-counsel-chat",

  "dataloader_num_workers": 8,
  "dataloader_pin_memory": true,
  "gradient_checkpointing": false,
  "ddp_find_unused_parameters": false,

  "optim": "adamw_torch_fused",
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "lr_scheduler_type": "constant",

  "save_strategy": "steps",
  "eval_strategy": "steps",
  "load_best_model_at_end": false,
  "metric_for_best_model": "eval_loss",
  "greater_is_better": false,
  "report_to": "none",
  "remove_unused_columns": false,
  "use_cache": false,

  "_extreme_speed_optimizations": [
    "✅ Only 1 epoch - minimal training time",
    "✅ max_length=256 (4x faster than 1024)",
    "✅ LoRA rank=8 (minimal adapter size)",
    "✅ Only 2 LoRA modules (q_proj, v_proj) - 3.5x fewer parameters",
    "✅ batch_size=8 per GPU - maximum throughput",
    "✅ gradient_accumulation=2 - fast optimizer updates",
    "✅ No gradient checkpointing - trades memory for speed",
    "✅ Rare eval (200 steps) - minimal validation overhead",
    "✅ Rare saves (500 steps) - minimal I/O",
    "✅ No early stopping - no eval overhead",
    "✅ Constant LR schedule - no schedule compute",
    "✅ No weight decay - faster optimizer",
    "✅ Minimal warmup (1%) - learn immediately",
    "✅ 8 dataloader workers - maximize data throughput",
    "✅ High learning rate (5e-4) - rapid convergence",
    "✅ ignore_checkpoints=true - always start fresh (no resume overhead)",
    "⚠️ Expected time: 30-45 minutes on 8 GPUs",
    "⚠️ Quality will be significantly lower than normal configs"
  ]
}

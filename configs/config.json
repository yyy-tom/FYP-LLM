{
  "model_name": "Qwen/Qwen2.5-7B-Instruct-AWQ",
  "dataset_path": "datasets/counsel_chat_processed",
  "output_dir": "models/qwen2.5-counsel-chat-finetuned",
  "batch_size": 4,
  "num_epochs": 3,
  "learning_rate": 2e-4,
  "use_wandb": false,
  "use_4bit": false,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "max_length": 1024,
  "gradient_accumulation_steps": 1,
  "eval_batch_size": 8,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "logging_steps": 10,
  "eval_steps": 50,
  "save_steps": 200,
  "save_total_limit": 3,
  "fp16": false,
  "bf16": true,
  "early_stopping": true,
  "seed": 42,
  "run_name": "qwen2.5-counsel-chat-8gpu",
  "wandb_project": "qwen2.5-counsel-chat",
  "dataloader_num_workers": 4,
  "dataloader_pin_memory": true,
  "gradient_checkpointing": true,
  "ddp_find_unused_parameters": false,
  "optim": "adamw_torch_fused",
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "lr_scheduler_type": "cosine",
  "remove_unused_columns": true,
  "low_cpu_mem_usage": true,
  "use_cache": false
}
